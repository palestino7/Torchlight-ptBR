# Torchlight pt-BR .gitignore
# Exclude distribution binaries and compiled payloads
dist/
*.exe
*.zip

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
tools/*.txt
tools/_*.json
tools/untranslated_dump.json

# Agent metadata and working state
.agents/

# OS specific files
Thumbs.db
[Ee]xthumbs.db
ehthumbs.db
[Dd]esktop.ini
.DS_Store
